PROJECT_NAME           = "DESFire EV3 SDK"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@DESFIRE_DOXYGEN_OUTPUT_DIRECTORY@"
INPUT                  = "@PROJECT_SOURCE_DIR@/foundation/include" \
                         "@PROJECT_SOURCE_DIR@/core/include" \
                         "@PROJECT_SOURCE_DIR@/providers/crypto-openssl/include" \
                         "@PROJECT_SOURCE_DIR@/transports/callback/include" \
                         "@PROJECT_SOURCE_DIR@/transports/replay/include" \
                         "@PROJECT_SOURCE_DIR@/transports/pcsc/include" \
                         "@PROJECT_SOURCE_DIR@/c-api/include" \
                         "@PROJECT_SOURCE_DIR@/sdk/cpp17/include"
FILE_PATTERNS          = *.h *.hpp *.c *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */.build/* */node_modules/* */docs/vendor/*
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
# The repository checker enforces a block on every authored declaration and definition.
# Doxygen remains strict about malformed documentation without requiring redundant
# @param/@return tags when the contract is already clear in the prose.
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
QUIET                  = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
HAVE_DOT               = NO
