{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desfire.dev/schema/ev3-api.schema.json",
  "title": "DESFire EV3 binding operation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "abiVersion", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "abiVersion": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cType", "semanticType", "ownership"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "cType": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "ownership": { "enum": ["value", "borrowed", "output"] },
        "units": { "type": "string" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "optional": { "type": "boolean" },
        "default": {},
        "notes": { "type": "string" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cSymbol",
        "coreOperation",
        "domain",
        "surface",
        "summary",
        "documentation",
        "mutation",
        "deliveryRules",
        "sessionEffect",
        "parameters",
        "result"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "cSymbol": { "type": "string", "pattern": "^df_[a-z0-9_]+$" },
        "coreOperation": { "type": "string", "minLength": 1 },
        "domain": {
          "enum": [
            "runtime",
            "discovery",
            "authentication",
            "applications",
            "keys",
            "files",
            "transactions",
            "card_management",
            "iso7816",
            "offline",
            "raw"
          ]
        },
        "surface": { "enum": ["runtime", "managed", "raw", "offline"] },
        "summary": { "type": "string", "minLength": 1 },
        "documentation": { "type": "string", "minLength": 1 },
        "mutation": { "type": "boolean" },
        "deliveryRules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "preserve_outcome",
              "never_retry_after_send",
              "reconciliation_on_unknown",
              "provider_before_io",
              "preserve_native_status",
              "preserve_iso_status"
            ]
          }
        },
        "sessionEffect": {
          "enum": ["none", "select", "install", "replace", "reset", "invalidate"]
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "result": {
          "enum": [
            "void",
            "bytes",
            "uint32",
            "int32",
            "boolean",
            "authentication_info",
            "delegated_application_info",
            "native_response",
            "iso_response"
          ]
        },
        "authentication": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
